# The SelfStudy E-Learning desktop app (selfstudyjo-desktop-elearning): `vite build --mode desktop`.
# Loaded on top of .env. The desktop app answers the registry and every service on the
# student's computer, so the registry points at a local name and the token is a placeholder:
# NO platform credential may ever be compiled into the desktop build (its build script checks).
VITE_AUTH_TOKEN=sfs-desktop-local
VITE_API_BASE_REGISTRY=https://registry.sfs.local
VITE_REGISTRY_ALT=https://registry.sfs.local
VITE_DESKTOP=1
# Network Simulator projects stay in the browser's own storage on the desktop.
VITE_NETSIM_STORAGE_PROXY=

{
  "name": "selfstudy2026",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "check:photomask": "vite build --config tools/photomask-check/vite.config.ts && node tools/photomask-check/dist/check.mjs",
    "check:drawengine": "vite build --config tools/drawengine-check/vite.config.ts && node tools/drawengine-check/dist/check.mjs",
    "check:chatmedia": "vite build --config tools/chatmedia-check/vite.config.ts && node tools/chatmedia-check/dist/check.mjs",
    "check:appnav": "vite build --config tools/appnav-check/vite.config.ts && node tools/appnav-check/dist/check.mjs",
    "check:theme": "vite build --config tools/theme-check/vite.config.ts && node tools/theme-check/dist/check.mjs",
    "check:linkify": "vite build --config tools/linkify-check/vite.config.ts && node tools/linkify-check/dist/check.mjs",
    "check:notifyevents": "vite build --config tools/notifyevents-check/vite.config.ts && node tools/notifyevents-check/dist/check.mjs",
    "check:cssleaks": "vite build --config tools/cssleaks-check/vite.config.ts && node tools/cssleaks-check/dist/check.mjs",
    "check:examshuffle": "vite build --config tools/examshuffle-check/vite.config.ts && node tools/examshuffle-check/dist/check.mjs",
    "check:proctorqueue": "vite build --config tools/proctorqueue-check/vite.config.ts && node tools/proctorqueue-check/dist/check.mjs",
    "check:newscast": "vite build --config tools/newscast-check/vite.config.ts && node tools/newscast-check/dist/check.mjs",
    "check:actors": "vite build --config tools/actors-check/vite.config.ts && node tools/actors-check/dist/check.mjs",
    "check:jitypes": "node tools/jitypes-check/check.mjs",
    "check:i18n": "vite build --config tools/i18n-check/vite.config.ts && node tools/i18n-check/dist/check.mjs",
    "check:datai18n": "vite build --config tools/datai18n-check/vite.config.ts && node tools/datai18n-check/dist/check.mjs",
    "check:qacoaching": "vite build --config tools/qacoaching-check/vite.config.ts && node tools/qacoaching-check/dist/check.mjs",
    "check:interview": "vite build --config tools/interview-check/vite.config.ts && node tools/interview-check/dist/check.mjs",
    "check:answeredit": "vite build --config tools/answeredit-check/vite.config.ts && node tools/answeredit-check/dist/check.mjs",
    "check:leaderboard": "vite build --config tools/leaderboard-check/vite.config.ts && node tools/leaderboard-check/dist/check.mjs",
    "check:lessoncontent": "vite build --config tools/lessoncontent-check/vite.config.ts && node tools/lessoncontent-check/dist/check.mjs",
    "preview:leaderboard": "vite --config tools/leaderboard-preview/vite.config.ts",
    "build:leaderboard-preview": "vite build --config tools/leaderboard-preview/vite.config.ts",
    "check": "npm run check:photomask && npm run check:drawengine && npm run check:chatmedia && npm run check:appnav && npm run check:theme && npm run check:linkify && npm run check:notifyevents && npm run check:cssleaks && npm run check:examshuffle && npm run check:proctorqueue && npm run check:newscast && npm run check:actors && npm run check:interview && npm run check:answeredit && npm run check:qacoaching && npm run check:leaderboard && npm run check:lessoncontent && npm run check:jitypes && npm run check:i18n && npm run check:datai18n",
    "audit:contrast": "vite build --config tools/theme-check/themes.config.ts && node tools/theme-check/audit-contrast.mjs",
    "audit:ink": "vite build --config tools/theme-check/themes.config.ts && node tools/theme-check/audit-ink.mjs",
    "audit:pairs": "node tools/tokenize-colors/audit-pairs.mjs",
    "audit": "npm run audit:pairs && npm run audit:ink && npm run audit:contrast",
    "i18n:wrap": "node tools/i18n-wrap/wrap.mjs",
    "i18n:logical": "node tools/i18n-wrap/logical.mjs",
    "i18n:where": "node tools/i18n-wrap/where.mjs",
    "audit:rtl": "node tools/rtl-audit/audit.mjs",
    "preview:cast": "vite --config tools/cast-preview/vite.config.ts",
    "build:cast-preview": "vite build --config tools/cast-preview/vite.config.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^8.56.2",
    "chart.js": "^4.5.1",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.562.0",
    "marked": "^17.0.4",
    "pinia": "^3.0.4",
    "three": "^0.183.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "gh-pages": "^6.3.0",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vue-tsc": "^3.1.4"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}

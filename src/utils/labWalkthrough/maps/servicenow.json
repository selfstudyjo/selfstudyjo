     "zone": "nav",
     "action": "click",
     "target": "All"
    },
    {
     "say": "Open the incident {1} from the list.",
     "screen": "Incidents",
     "nav": "Incident",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "Set Impact to {2}.",
     "screen": "{1}",
     "nav": "Incident",
     "zone": "main",
     "action": "select",
     "target": "Impact",
     "value": "{2}"
    },
    {
     "say": "Set Urgency to {3}. Priority is calculated from the two.",
     "screen": "{1}",
     "nav": "Incident",
     "zone": "main",
     "action": "select",
     "target": "Urgency",
     "value": "{3}"

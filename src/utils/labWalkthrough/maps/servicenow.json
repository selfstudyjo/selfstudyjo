{
 "skin": "servicenow",
 "product": "ServiceNow",
 "brand": "#032d42",
 "top": "ServiceNow",
 "nav": [
  "All",
  "Incident",
  "Major Incidents",
  "Problem",
  "Change",
  "On-Call Scheduling",
  "Event Management",
  "Service Level Management"
 ],
 "recipes": [
  {
   "id": "inc-create",
   "title": "Create an incident",
   "match": "snow\\s+incident\\s+create\\s+--short\\s+\\\"([^\\\"]*)\\\"(?:\\s+--ci\\s+([\\w.-]+))?(?:\\s+--impact\\s+(\\d))?(?:\\s+--urgency\\s+(\\d))?(?:\\s+--group\\s+\\\"([^\\\"]*)\\\")?",
   "steps": [
    {
     "say": "Open the All menu in the top bar.",
     "screen": "Service Operations",
     "zone": "top",
     "action": "click",
     "target": "All"
    },
    {
     "say": "Under Incident, choose Create New.",
     "screen": "Incident - New record",
     "nav": "Incident",
     "zone": "nav",
     "action": "click",
     "target": "Create New"
    },
    {
     "say": "Type the Short description: {1}",
     "screen": "Incident - New record",
     "nav": "Incident",
     "zone": "main",
     "action": "type",
     "target": "Short description",
     "value": "{1}"
    },
    {
     "say": "Pick the Configuration item {2}.",
     "screen": "Incident - New record",
     "nav": "Incident",
     "zone": "main",
     "action": "select",
     "target": "Configuration item",
     "value": "{2}",
     "optional": true
    },
    {
     "say": "Set Impact to {3}.",
     "screen": "Incident - New record",
     "nav": "Incident",
     "zone": "main",
     "action": "select",
     "target": "Impact",
     "value": "{3}",
     "optional": true
    },
    {
     "say": "Set Urgency to {4}.",
     "screen": "Incident - New record",
     "nav": "Incident",
     "zone": "main",
     "action": "select",
     "target": "Urgency",
     "value": "{4}",
     "optional": true
    },
    {
     "say": "Set Assignment group to {5}.",
     "screen": "Incident - New record",
     "nav": "Incident",
     "zone": "main",
     "action": "select",
     "target": "Assignment group",
     "value": "{5}",
     "optional": true
    },
    {
     "say": "Press Submit.",
     "screen": "Incident - New record",
     "nav": "Incident",
     "zone": "toolbar",
     "action": "click",
     "target": "Submit"
    }
   ],
   "verify": "The new incident number (INC...) appears in the list."
  },
  {
   "id": "inc-ack",
   "title": "Acknowledge an incident",
   "match": "snow\\s+incident\\s+ack\\s+(INC\\d+)",
   "steps": [
    {
     "say": "Open the All menu in the top bar.",
     "screen": "Service Operations",
     "zone": "top",
     "action": "click",
     "target": "All"
    },
    {
     "say": "Under Incident, choose All.",
     "screen": "Incidents",
     "nav": "Incident",
     "zone": "nav",
     "action": "click",
     "target": "All"
    },
    {
     "say": "Open the incident {1} from the list.",
     "screen": "Incidents",
     "nav": "Incident",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "Press Assign to me. This starts work and stops the pick-up clock.",
     "screen": "{1}",
     "nav": "Incident",
     "zone": "toolbar",
     "action": "click",
     "target": "Assign to me"
    }
   ],
   "verify": "State becomes In Progress and Assigned to shows your name."
  },
  {
   "id": "inc-assign",

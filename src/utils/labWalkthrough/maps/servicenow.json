  {
   "id": "inc-priority",
   "title": "Change an incident's priority",
   "match": "snow\\s+incident\\s+priority\\s+(INC\\d+)\\s+--impact\\s+(\\d)\\s+--urgency\\s+(\\d)(?:\\s+--reason\\s+\\\"([^\\\"]*)\\\")?",
   "steps": [
    {
     "say": "Open the All menu in the top bar.",

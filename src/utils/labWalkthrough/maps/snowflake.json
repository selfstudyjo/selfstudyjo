  {
   "id": "stage-create",
   "title": "Create an external stage",
   "match": "CREATE\\s+STAGE\\s+(?:IF\\s+NOT\\s+EXISTS\\s+)?([\\w.]+)\\s+URL\\s*=\\s*'([^']+)'(?:\\s+STORAGE_INTEGRATION\\s*=\\s*(\\w+))?",
   "steps": [
    {
     "say": "Press + Create in the left navigation and choose Stage.",
     "screen": "Home",
     "zone": "nav",
     "action": "click",
     "target": "Stage"
    },
    {
     "say": "Pick the Database and Schema, then type the Name (the last part of {1}).",
     "screen": "Create Stage",
     "zone": "dialog",
     "action": "type",
     "target": "Name",
     "value": "{1}"
    },
    {
     "say": "Set Stage type to external and type the URL {2}.",
     "screen": "Create Stage",
     "zone": "dialog",
     "action": "type",
     "target": "URL",
     "value": "{2}"
    },
    {
     "say": "Type {3} in Storage integration.",
     "screen": "Create Stage",
     "zone": "dialog",
     "action": "type",
     "target": "Storage integration (optional)",
     "value": "{3}",
     "optional": true
    },
    {
     "say": "Pick the File format named in the statement, if any.",
     "screen": "Create Stage",
     "zone": "dialog",
     "action": "select",
     "target": "File format (optional)"
    },
    {
     "say": "Press Create.",
     "screen": "Create Stage",
     "zone": "dialog",
     "action": "click",
     "target": "Create"
    }
   ]
  },

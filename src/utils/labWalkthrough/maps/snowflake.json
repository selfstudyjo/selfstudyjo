    {
     "say": "Type {3} in Max clusters.",
     "screen": "Edit warehouse",
     "zone": "dialog",
     "action": "type",
     "target": "Max clusters",
     "value": "{3}"
    },
    {
     "say": "Choose the Scaling policy {4}.",
     "screen": "Edit warehouse",
     "zone": "dialog",
     "action": "select",
     "target": "Scaling policy",
     "value": "{4}",
     "optional": true
    },
    {
     "say": "Press Save Warehouse.",
     "screen": "Edit warehouse",
     "zone": "dialog",
     "action": "click",
     "target": "Save Warehouse"
    }
   ]
  },
  {
   "id": "warehouse-autosuspend",
   "title": "Change auto-suspend",
   "match": "ALTER\\s+WAREHOUSE\\s+(\\w+)\\s+SET\\s+AUTO_SUSPEND\\s*=\\s*(\\d+)",

{
 "skin": "snowflake",
 "product": "Snowflake Snowsight",
 "brand": "#29b5e8",
 "top": "Snowflake",
 "nav": [
  "Home",
  "Worksheets",
  "Databases",
  "Query History",
  "Copy History",
  "Task History",
  "Governance",
  "Cost Management",
  "Warehouses"
 ],
 "recipes": [
  {
   "id": "warehouse-create",
   "title": "Create a warehouse",
   "match": "CREATE\\s+WAREHOUSE\\s+(?:IF\\s+NOT\\s+EXISTS\\s+)?(\\w+)\\s+(?:WITH\\s+)?WAREHOUSE_SIZE\\s*=\\s*'?(\\w+)'?(?:\\s+AUTO_SUSPEND\\s*=\\s*(\\d+))?",
   "steps": [
    {
     "say": "In the left navigation open Admin and choose Warehouses.",
     "screen": "Warehouses",
     "zone": "nav",
     "action": "click",
     "target": "Warehouses"
    },
    {
     "say": "Press + Warehouse.",
     "screen": "Warehouses",
     "zone": "toolbar",
     "action": "click",
     "target": "+ Warehouse"
    },
    {
     "say": "Type {1} as the Name.",
     "screen": "New Warehouse",
     "zone": "dialog",
     "action": "type",
     "target": "Name",
     "value": "{1}"
    },
    {
     "say": "Choose the Size {2}.",
     "screen": "New Warehouse",
     "zone": "dialog",
     "action": "select",
     "target": "Size",
     "value": "{2}"
    },
    {
     "say": "Under Advanced options set Auto suspend to {3} seconds (60 = 1 minute).",
     "screen": "New Warehouse",
     "zone": "dialog",
     "action": "select",
     "target": "Auto suspend",
     "value": "{3}",
     "optional": true
    },
    {
     "say": "Tick Initially suspended if the statement says INITIALLY_SUSPENDED = TRUE.",
     "screen": "New Warehouse",
     "zone": "dialog",
     "action": "check",
     "target": "Initially suspended"
    },
    {
     "say": "Press Create.",
     "screen": "New Warehouse",
     "zone": "dialog",
     "action": "click",
     "target": "Create"
    }
   ],
   "verify": "The warehouse appears in the Warehouses list."
  },
  {
   "id": "warehouse-resize",
   "title": "Resize a warehouse",
   "match": "ALTER\\s+WAREHOUSE\\s+(\\w+)\\s+SET\\s+WAREHOUSE_SIZE\\s*=\\s*'?(\\w+)'?",
   "steps": [
    {
     "say": "In the left navigation open Admin and choose Warehouses.",
     "screen": "Warehouses",
     "zone": "nav",
     "action": "click",
     "target": "Warehouses"
    },
    {
     "say": "Press the actions button at the end of the {1} row and choose Edit.",
     "screen": "Warehouses",
     "zone": "main",
     "action": "click",
     "target": "Edit"
    },
    {
     "say": "Choose the Size {2}.",
     "screen": "Edit warehouse",
     "zone": "dialog",
     "action": "select",
     "target": "Size",
     "value": "{2}"
    },
    {
     "say": "Press Save Warehouse.",
     "screen": "Edit warehouse",
     "zone": "dialog",
     "action": "click",
     "target": "Save Warehouse"
    }
   ],
   "verify": "The Size column shows the new size."
  },
  {
   "id": "warehouse-multicluster",
   "title": "Make a warehouse multi-cluster",
   "match": "ALTER\\s+WAREHOUSE\\s+(\\w+)\\s+SET\\s+MIN_CLUSTER_COUNT\\s*=\\s*(\\d+)\\s+MAX_CLUSTER_COUNT\\s*=\\s*(\\d+)(?:\\s+SCALING_POLICY\\s*=\\s*'?(\\w+)'?)?",
   "steps": [
    {
     "say": "In the left navigation open Admin and choose Warehouses.",
     "screen": "Warehouses",
     "zone": "nav",
     "action": "click",
     "target": "Warehouses"
    },
    {
     "say": "Press the actions button at the end of the {1} row and choose Edit.",
     "screen": "Warehouses",
     "zone": "main",
     "action": "click",
     "target": "Edit"
    },
    {
     "say": "Type {2} in Min clusters.",
     "screen": "Edit warehouse",
     "zone": "dialog",
     "action": "type",
     "target": "Min clusters",
     "value": "{2}"

     "say": "Read the Status column: Started or Suspended.",
     "screen": "Warehouses",
     "zone": "main",
     "action": "see",
     "target": "Status"
    }
   ]
  },
  {
   "id": "monitor-create",
   "title": "Create a resource monitor",
   "match": "CREATE\\s+RESOURCE\\s+MONITOR\\s+(\\w+)\\s+WITH\\s+CREDIT_QUOTA\\s*=\\s*([\\d.]+)(?:\\s+FREQUENCY\\s*=\\s*(\\w+))?",
   "steps": [
    {
     "say": "In the left navigation open Admin and choose Cost Management.",
     "screen": "Cost Management",
     "zone": "nav",
     "action": "click",
     "target": "Cost Management"
    },
    {
     "say": "Open the Resource Monitors tab.",
     "screen": "Cost Management",
     "zone": "tab",
     "action": "click",
     "target": "Resource Monitors"
    },
    {
     "say": "Press + Resource Monitor.",
     "screen": "Cost Management",
     "zone": "toolbar",
     "action": "click",
     "target": "+ Resource Monitor"
    },
    {
     "say": "Type {1} as the Name and {2} as the Credit quota.",
     "screen": "New Resource Monitor",
     "zone": "dialog",
     "action": "type",
     "target": "Credit quota",
     "value": "{2}"
    },
    {
     "say": "Choose the Schedule {3}.",
     "screen": "New Resource Monitor",
     "zone": "dialog",
     "action": "select",
     "target": "Schedule",
     "value": "{3}",
     "optional": true
    },
    {
     "say": "Under Actions tick Notify at and Suspend at, with the percentages from the statement.",
     "screen": "New Resource Monitor",
     "zone": "dialog",
     "action": "check",
     "target": "Suspend at"
    },
    {
     "say": "Press Create.",
     "screen": "New Resource Monitor",
     "zone": "dialog",
     "action": "click",
     "target": "Create"
    }
   ],
   "verify": "The monitor is listed on the Resource Monitors tab."
  },
  {
   "id": "monitors-show",
   "title": "See the resource monitors",
   "match": "SHOW\\s+RESOURCE\\s+MONITORS",

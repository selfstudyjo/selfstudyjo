   "match": "(CREATE\\s+(?:OR\\s+REPLACE\\s+)?PIPE\\s+[\\w.]+[^\\\"]*)",
   "steps": [
    {
     "say": "Press + Create in the left navigation and choose SQL Worksheet.",
     "screen": "Home",
     "zone": "nav",
     "action": "click",
     "target": "SQL Worksheet"
    },
    {
     "say": "Type the statement in the editor: {1}",
     "screen": "Worksheet",
     "zone": "editor",

{
 "skin": "airflow",
 "product": "Apache Airflow",
 "brand": "#017cee",
 "top": "Airflow",
 "nav": [
  "DAGs",
  "Cluster Activity",
  "Datasets",
  "Security",
  "Browse",
  "Admin",
  "Docs"
 ],
 "recipes": [
  {
   "id": "dag-pause",
   "title": "Switch a DAG on or off",
   "match": "airflow\\s+dags\\s+(unpause|pause)\\s+([\\w.-]+)",
   "steps": [
    {
     "say": "Open DAGs in the top bar.",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "DAGs"
    },
    {
     "say": "Find {2} in the list.",
     "screen": "DAGs",
     "zone": "main",
     "action": "see",
     "target": "{2}"
    },
    {
     "say": "Click the switch at the start of its row: on (blue) means active, off means paused. Use it to {1} the DAG.",
     "screen": "DAGs",
     "zone": "main",
     "action": "click",
     "target": "Pause/Unpause DAG {2}"
    }
   ],
   "verify": "The switch shows the new state and the DAG is listed under Active or Paused."
  },
  {
   "id": "dag-trigger",
   "title": "Trigger a DAG run",
   "match": "airflow\\s+dags\\s+trigger\\s+([\\w.-]+)(?:\\s+-e\\s+(\\S+))?",
   "steps": [
    {
     "say": "Open DAGs in the top bar.",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "DAGs"
    },
    {
     "say": "Click the DAG {1} in the list.",
     "screen": "DAGs",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "Press Trigger and choose Trigger DAG w/ config.",
     "screen": "DAG",
     "zone": "toolbar",
     "action": "click",
     "target": "Trigger DAG w/ config"
    },
    {
     "say": "Type {2} as the Logical date.",
     "screen": "Trigger DAG",
     "zone": "dialog",
     "action": "type",
     "target": "Logical date",
     "value": "{2}",
     "optional": true
    },
    {
     "say": "Press Trigger.",
     "screen": "Trigger DAG",
     "zone": "dialog",
     "action": "click",
     "target": "Trigger"
    }
   ],
   "verify": "A new run column appears in the Grid."
  },
  {
   "id": "dag-backfill",
   "title": "Backfill a date range",
   "match": "airflow\\s+dags\\s+backfill\\s+-s\\s+(\\S+)\\s+-e\\s+(\\S+)\\s+(--reset-dagruns)?(?:\\s*-y)?\\s*([\\w.-]+)",
   "steps": [
    {
     "say": "Open DAGs in the top bar.",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "DAGs"
    },
    {
     "say": "Click the DAG {4} in the list.",
     "screen": "DAGs",
     "zone": "main",
     "action": "click",
     "target": "{4}"
    },
    {
     "say": "Press Trigger and choose Backfill (CLI).",
     "screen": "DAG",
     "zone": "toolbar",
     "action": "click",
     "target": "Backfill (CLI)…"
    },
    {
     "say": "Type {1} as the Start date.",
     "screen": "Backfill (CLI)",
     "zone": "dialog",
     "action": "type",
     "target": "Start date (-s)",
     "value": "{1}"
    },
    {
     "say": "Type {2} as the End date.",
     "screen": "Backfill (CLI)",
     "zone": "dialog",
     "action": "type",
     "target": "End date (-e)",
     "value": "{2}"
    },
    {
     "say": "Tick {3} to clear and re-run the runs that already exist.",
     "screen": "Backfill (CLI)",
     "zone": "dialog",
     "action": "check",
     "target": "--reset-dagruns",
     "value": "{3}",
     "optional": true
    },
    {
     "say": "Press Run in the CLI.",
     "screen": "Backfill (CLI)",
     "zone": "dialog",
     "action": "click",
     "target": "Run in the CLI"
    }
   ],
   "verify": "Backfill runs (backfill__...) appear in the Grid."
  },
  {
   "id": "task-clear",
   "title": "Clear one task in a run",
   "match": "airflow\\s+tasks\\s+clear\\s+([\\w.-]+)\\s+-t\\s+([\\w.-]+)\\s+-s\\s+(\\S+)",
   "steps": [
    {
     "say": "Open DAGs in the top bar.",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "DAGs"
    },
    {
     "say": "Click the DAG {1} in the list.",
     "screen": "DAGs",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "In the Grid, click the square of task {2} in the run of {3}.",
     "screen": "DAG",
     "zone": "main",
     "action": "click",
     "target": "{2}"
    },
    {
     "say": "In the task panel on the right, press Clear task.",
     "screen": "Task Instance",
     "zone": "panel",
     "action": "click",
     "target": "Clear task"
    },
    {
     "say": "Watch the square go back to queued and then run again.",
     "screen": "DAG",
     "zone": "main",
     "action": "see",
     "target": "Grid"
    }
   ]
  },
  {
   "id": "run-clear-failed",
   "title": "Clear only the failed tasks of a run",
   "match": "airflow\\s+tasks\\s+clear\\s+([\\w.-]+)\\s+-s\\s+(\\S+)\\s+-e\\s+\\S+\\s+--only-failed",
   "steps": [
    {
     "say": "Open DAGs in the top bar.",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "DAGs"
    },
    {
     "say": "Click the DAG {1} in the list.",
     "screen": "DAGs",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "In the Grid on the left, click the column of the run for {2}.",
     "screen": "DAG",
     "zone": "main",
     "action": "click",
     "target": "Grid"
    },
    {
     "say": "Press Clear and choose Clear only failed tasks.",
     "screen": "DAG Run",
     "zone": "panel",
     "action": "click",
     "target": "Clear only failed tasks"
    },
    {
     "say": "Read the list of task instances and press Clear.",
     "screen": "Clear",
     "zone": "dialog",
     "action": "click",
     "target": "Clear"
    }
   ]
  },
  {
   "id": "run-clear",
   "title": "Clear a whole run",
   "match": "airflow\\s+tasks\\s+clear\\s+([\\w.-]+)\\s+-s\\s+(\\S+)",
   "steps": [
    {
     "say": "Open DAGs in the top bar.",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "DAGs"
    },
    {
     "say": "Click the DAG {1} in the list.",
     "screen": "DAGs",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "In the Grid on the left, click the column of the run for {2}.",
     "screen": "DAG",
     "zone": "main",
     "action": "click",
     "target": "Grid"
    },
    {
     "say": "Press Clear and choose Clear existing tasks.",
     "screen": "DAG Run",
     "zone": "panel",
     "action": "click",
     "target": "Clear existing tasks"
    },
    {
     "say": "Read the list of task instances and press Clear.",
     "screen": "Clear",
     "zone": "dialog",
     "action": "click",
     "target": "Clear"
    }
   ]
  },
  {
   "id": "task-logs",
   "title": "Read a task log",
   "match": "airflow\\s+tasks\\s+logs\\s+([\\w.-]+)\\s+([\\w.-]+)\\s+(\\S+)",
   "steps": [
    {
     "say": "Open DAGs in the top bar.",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "DAGs"
    },
    {
     "say": "Click the DAG {1} in the list.",
     "screen": "DAGs",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "In the Grid, click the square of task {2} in the run {3}.",
     "screen": "DAG",
     "zone": "main",
     "action": "click",
     "target": "{2}"
    },
    {
     "say": "Open the Logs tab and read the log. Pick another try number if there are several.",
     "screen": "DAG",
     "zone": "tab",
     "action": "see",
     "target": "Logs"
    }
   ]
  },
  {
   "id": "task-render",
   "title": "See a rendered template",
   "match": "airflow\\s+tasks\\s+render\\s+([\\w.-]+)\\s+([\\w.-]+)\\s+(\\S+)",
   "steps": [
    {
     "say": "Open DAGs in the top bar.",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "DAGs"
    },
    {
     "say": "Click the DAG {1} in the list.",
     "screen": "DAGs",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "In the Grid, click the square of task {2} in the run of {3}.",
     "screen": "DAG",
     "zone": "main",
     "action": "click",
     "target": "{2}"
    },
    {
     "say": "Open the Rendered Template tab to see the values the templates turned into.",
     "screen": "DAG",
     "zone": "tab",
     "action": "see",
     "target": "Rendered Template"
    }
   ]
  },
  {
   "id": "run-states",
   "title": "See the task states of a run",
   "match": "airflow\\s+tasks\\s+states-for-dag-run\\s+([\\w.-]+)\\s+(\\S+)",
   "steps": [
    {
     "say": "Open DAGs in the top bar.",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "DAGs"
    },
    {
     "say": "Click the DAG {1} in the list.",
     "screen": "DAGs",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "In the Grid, find the column of the run {2}.",
     "screen": "DAG",
     "zone": "main",
     "action": "click",
     "target": "Grid"
    },
    {
     "say": "Read the colour of each task square: green success, red failed, yellow up for retry.",
     "screen": "DAG",
     "zone": "main",
     "action": "see",
     "target": "Grid"
    }
   ]
  },
  {
   "id": "dag-runs",
   "title": "See the runs of a DAG",
   "match": "airflow\\s+dags\\s+list-runs\\s+(?:-d\\s+)?([\\w.-]+)",
   "steps": [
    {
     "say": "In the top bar open Browse and choose DAG Runs.",
     "screen": "DAG Runs",
     "zone": "top",
     "action": "click",
     "target": "Browse > DAG Runs"
    },
    {
     "say": "Filter or search for {1} and read each run: run id, type and state.",
     "screen": "DAG Runs",
     "zone": "main",
     "action": "see",
     "target": "{1}"
    }
   ]
  },
  {
   "id": "import-errors",
   "title": "See the DAG import errors",
   "match": "airflow\\s+dags\\s+list-import-errors",
   "steps": [
    {
     "say": "Open DAGs in the top bar.",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "DAGs"
    },
    {
     "say": "If a file does not parse, a red DAG Import Errors banner sits above the list: click it to read the error.",
     "screen": "DAGs",
     "zone": "main",
     "action": "click",
     "target": "DAG Import Errors"
    }
   ]
  },
  {
   "id": "tasks-list",
   "title": "See the tasks of a DAG",
   "match": "airflow\\s+(?:tasks\\s+list|dags\\s+show)\\s+([\\w.-]+)",
   "steps": [
    {
     "say": "Open DAGs in the top bar.",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "DAGs"
    },
    {
     "say": "Click the DAG {1} in the list.",
     "screen": "DAGs",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "Open the Graph tab to see every task and the arrows between them.",
     "screen": "DAG",
     "zone": "tab",
     "action": "see",
     "target": "Graph"
    }
   ]
  },
  {
   "id": "dags-list",
   "title": "See all DAGs",
   "match": "airflow\\s+dags\\s+list(?![\\w-])",
   "steps": [
    {
     "say": "Open DAGs in the top bar.",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "DAGs"
    },
    {
     "say": "Read the list: each DAG, its owner, schedule, last run and whether it is paused.",
     "screen": "DAGs",
     "zone": "main",
     "action": "see",
     "target": "DAGs"
    }
   ]
  },
  {
   "id": "sla-misses",
   "title": "See SLA misses",
   "match": "SLA Misses",
   "steps": [
    {
     "say": "In the top bar open Browse and choose SLA Misses.",
     "screen": "SLA Misses",
     "zone": "top",
     "action": "click",
     "target": "Browse > SLA Misses"
    },
    {
     "say": "Read which task missed its SLA and when.",
     "screen": "SLA Misses",
     "zone": "main",
     "action": "see",
     "target": "SLA Misses"
    }
   ]
  },
  {
   "id": "datasets",
   "title": "See datasets and their events",
   "match": "Datasets for|look at Datasets|dataset-triggered",
   "steps": [
    {
     "say": "Open Datasets in the top bar.",
     "screen": "Datasets",
     "zone": "top",
     "action": "click",
     "target": "Datasets"
    },
    {
     "say": "Click a dataset to see the events that updated it and the DAGs it triggers.",
     "screen": "Datasets",
     "zone": "main",
     "action": "see",
     "target": "Datasets"
    }
   ]
  },
  {
   "id": "platform-clock",
   "title": "Advance the simulated clock",
   "match": "platform\\s+clock\\s+(\\+(?:15m|1h|6h|1d))(?!\\w)",
   "steps": [
    {
     "say": "Press the clock in the top bar (it shows the simulated UTC time).",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "UTC clock"
    },
    {
     "say": "Choose Advance clock {1}. The scheduler catches up and starts any runs that are now due.",
     "screen": "DAGs",
     "zone": "top",
     "action": "click",
     "target": "Advance clock {1}"
    }
   ]
  }
 ]
}

{
 "skin": "fabric",
 "product": "Microsoft Fabric",
 "brand": "#117865",
 "top": "Microsoft Fabric",
 "nav": [
  "Home",
  "Workspaces",
  "OneLake catalog",
  "Monitor",
  "Real-Time",
  "Workloads",
  "Create"
 ],
 "recipes": [
  {
   "id": "create-item",
   "title": "Create a lakehouse, warehouse or item",
   "match": "fab\\s+mkdir\\s+([\\w.-]+)\\.Workspace/([\\w.-]+)\\.(Lakehouse|Warehouse|Notebook|DataPipeline|SemanticModel)(?!/)",
   "steps": [
    {
     "say": "Open Workspaces in the left navigation.",
     "screen": "Workspaces",
     "nav": "Workspaces",
     "zone": "nav",
     "action": "click",
     "target": "Workspaces"
    },
    {
     "say": "Open the workspace {1}.",
     "screen": "Workspaces",
     "nav": "Workspaces",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "Press New item.",
     "screen": "{1}",
     "nav": "Workspaces",
     "zone": "toolbar",
     "action": "click",
     "target": "New item"
    },
    {
     "say": "Pick the {3} tile.",
     "screen": "New item",
     "zone": "dialog",
     "action": "click",
     "target": "{3}"
    },
    {
     "say": "Type {2} as the Name.",
     "screen": "New item",
     "zone": "dialog",
     "action": "type",
     "target": "Name",
     "value": "{2}"
    },
    {
     "say": "Press Create.",
     "screen": "New item",
     "zone": "dialog",
     "action": "click",
     "target": "Create"
    }
   ],
   "verify": "The new item appears in the workspace list."
  },
  {
   "id": "import-item",
   "title": "Import a notebook, pipeline or semantic model from your Files",
   "match": "fab\\s+import\\s+([\\w.-]+)\\.Workspace/([\\w.-]+)\\.(Notebook|DataPipeline|SemanticModel)\\s+-i\\s+([\\w./-]+)",
   "steps": [
    {
     "say": "Open Workspaces in the left navigation.",
     "screen": "Workspaces",
     "nav": "Workspaces",
     "zone": "nav",
     "action": "click",
     "target": "Workspaces"
    },
    {
     "say": "Open the workspace {1}.",
     "screen": "Workspaces",
     "nav": "Workspaces",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "Press Import in the toolbar.",
     "screen": "{1}",
     "nav": "Workspaces",
     "zone": "toolbar",
     "action": "click",
     "target": "Import"
    },
    {
     "say": "Pick {4} - it is a file in your lab's Files tool.",
     "screen": "Import",
     "zone": "dialog",
     "action": "select",
     "target": "File from your lab's Files",
     "value": "{4}"
    },
    {
     "say": "Check the Item type is {3}.",
     "screen": "Import",
     "zone": "dialog",
     "action": "select",
     "target": "Item type",
     "value": "{3}"
    },
    {
     "say": "Check the Name is {2}.",
     "screen": "Import",
     "zone": "dialog",
     "action": "type",
     "target": "Name",
     "value": "{2}"
    },
    {
     "say": "Press Import.",
     "screen": "Import",
     "zone": "dialog",
     "action": "click",
     "target": "Import"
    }
   ],
   "verify": "{2} now appears in the {1} workspace list - you can open it and set its lakehouse."
  },
  {
   "id": "create-workspace",
   "title": "Create a workspace",
   "match": "fab\\s+mkdir\\s+([\\w.-]+)\\.Workspace(?!/)(?:\\s+-P\\s+capacityName=([\\w.-]+))?",
   "steps": [
    {
     "say": "Open Workspaces in the left navigation.",
     "screen": "Workspaces",
     "nav": "Workspaces",
     "zone": "nav",
     "action": "click",
     "target": "Workspaces"
    },
    {
     "say": "Press New workspace.",
     "screen": "Workspaces",
     "nav": "Workspaces",
     "zone": "toolbar",
     "action": "click",
     "target": "New workspace"
    },
    {
     "say": "Type {1} as the Name.",
     "screen": "Create a workspace",
     "zone": "panel",
     "action": "type",
     "target": "Name",
     "value": "{1}"
    },
    {
     "say": "Under Advanced choose Fabric capacity and the Capacity {2}.",
     "screen": "Create a workspace",
     "zone": "panel",
     "action": "select",
     "target": "Capacity",
     "value": "{2}",
     "optional": true
    },
    {
     "say": "Press Apply.",
     "screen": "Create a workspace",
     "zone": "panel",
     "action": "click",
     "target": "Apply"
    }
   ],
   "verify": "The new workspace opens and is listed under Workspaces."
  },
  {
   "id": "create-connection",
   "title": "Create a connection",
   "match": "fab\\s+mkdir\\s+\\.connections/([\\w.-]+)\\.Connection",
   "steps": [
    {
     "say": "Open the Settings gear in the top bar and choose Admin portal.",
     "screen": "Microsoft Fabric",
     "zone": "top",
     "action": "click",
     "target": "Admin portal"
    },
    {
     "say": "Open Manage connections and gateways.",
     "screen": "Admin portal",
     "zone": "tab",
     "action": "click",
     "target": "Manage connections and gateways"
    },
    {
     "say": "Press New.",
     "screen": "Manage connections",
     "zone": "toolbar",
     "action": "click",
     "target": "New"
    },
    {
     "say": "Type {1} as the Connection name and choose the type, server and Authentication method from the command.",
     "screen": "New connection",
     "zone": "dialog",
     "action": "type",
     "target": "Connection name",
     "value": "{1}"
    },
    {
     "say": "Press Create.",
     "screen": "New connection",
     "zone": "dialog",
     "action": "click",
     "target": "Create"
    }
   ]
  },
  {
   "id": "rm-workspace",
   "title": "Remove a workspace",
   "match": "fab\\s+rm\\s+([\\w.-]+)\\.Workspace\\s+-f",
   "steps": [
    {
     "say": "Open Workspaces in the left navigation.",
     "screen": "Workspaces",
     "nav": "Workspaces",
     "zone": "nav",
     "action": "click",
     "target": "Workspaces"
    },
    {
     "say": "Open the workspace {1}.",
     "screen": "Workspaces",
     "nav": "Workspaces",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "Open Workspace settings.",
     "screen": "{1}",
     "nav": "Workspaces",
     "zone": "toolbar",
     "action": "click",
     "target": "Workspace settings"
    },
    {
     "say": "Under Remove this workspace, type the name {1} to confirm and press Remove.",
     "screen": "Workspace settings",
     "zone": "panel",
     "action": "click",
     "target": "Remove this workspace"
    }
   ]
  },
  {
   "id": "rm-path",
   "title": "Delete a lakehouse folder",
   "match": "fab\\s+rm\\s+([\\w.-]+)\\.Workspace/([\\w.-]+)\\.Lakehouse/(Files/\\S+?)\\s+-f",

  {
   "id": "acl-item",
   "title": "Grant access to an item",
   "match": "fab\\s+acl\\s+set\\s+([\\w.-]+)\\.Workspace/([\\w.-]+)\\.(Lakehouse|Warehouse|Notebook|DataPipeline|SemanticModel)\\s+-I\\s+([\\w.-]+)\\s+-R\\s+([\\w,]+)",
   "steps": [
    {
     "say": "Open Workspaces in the left navigation.",
     "screen": "Workspaces",
     "nav": "Workspaces",
     "zone": "nav",
     "action": "click",
     "target": "Workspaces"
    },
    {
     "say": "Open the workspace {1}.",
     "screen": "Workspaces",
     "nav": "Workspaces",
     "zone": "main",
     "action": "click",
     "target": "{1}"
    },
    {
     "say": "Open the ... menu of {2} and choose Manage permissions.",
     "screen": "{1}",
     "nav": "Workspaces",
     "zone": "main",
     "action": "click",
     "target": "Manage permissions"
    },
    {
     "say": "Press Grant people access and enter {4}.",
     "screen": "Manage permissions",
     "zone": "panel",
     "action": "type",
     "target": "Enter a name or email address",
     "value": "{4}"
    },
    {
     "say": "Tick the Additional permissions for {5}.",
     "screen": "Manage permissions",
     "zone": "panel",
     "action": "check",
     "target": "Additional permissions",
     "value": "{5}"
    },
    {
     "say": "Press Grant.",
     "screen": "Manage permissions",
     "zone": "panel",
     "action": "click",
     "target": "Grant"
    }
   ]

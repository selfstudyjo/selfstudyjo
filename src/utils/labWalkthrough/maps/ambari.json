{
 "skin": "ambari",
 "product": "Apache Ambari",
 "brand": "#3fae2a",
 "top": "Ambari",
 "nav": [
  "Dashboard",
  "Services",
  "Hosts",
  "Alerts",
  "Cluster Admin"
 ],
 "recipes": [
  {
   "id": "files-mkdir",
   "title": "Create an HDFS folder",
   "match": "hdfs\\s+dfs\\s+-mkdir\\s+(?:-p\\s+)?((?:/[\\w.=*-]+)*)/([\\w.=*-]+)",
   "steps": [
    {
     "say": "Press the grid icon (Ambari Views) at the top right and choose Files View.",
     "screen": "Ambari",
     "zone": "top",
     "action": "click",
     "target": "Files View"
    },
    {
     "say": "Click through the path to the folder {1}.",
     "screen": "Files View",
     "zone": "main",
     "action": "click",
     "target": "{1}",
     "value": "{1}",
     "optional": true
    },
    {
     "say": "Press New Folder.",
     "screen": "Files View",
     "zone": "toolbar",
     "action": "click",
     "target": "New Folder"
    },
    {
     "say": "Type {2} as the Folder name.",
     "screen": "Add New Folder",
     "zone": "dialog",
     "action": "type",
     "target": "Folder name",
     "value": "{2}"
    },
    {
     "say": "Press Add.",
     "screen": "Add New Folder",
     "zone": "dialog",
     "action": "click",
     "target": "Add"
    }
   ],
   "verify": "The new folder appears in the list."
  },
  {
   "id": "files-setrep",
   "title": "Change a file's replication factor",
   "match": "hdfs\\s+dfs\\s+-setrep\\s+(?:-[wR]\\s+)?(\\d+)\\s+((?:/[\\w.=*-]+)*)/([\\w.=*-]+)",
   "steps": [
    {
     "say": "Press the grid icon (Ambari Views) at the top right and choose Files View.",
     "screen": "Ambari",
     "zone": "top",
     "action": "click",
     "target": "Files View"
    },
    {
     "say": "Click through the path to the folder {2}.",
     "screen": "Files View",
     "zone": "main",
     "action": "click",
     "target": "{2}",
     "value": "{2}",
     "optional": true
    },
    {
     "say": "Tick the checkbox next to {3}.",
     "screen": "Files View",
     "zone": "main",
     "action": "check",
     "target": "{3}"
    },
    {
     "say": "Press Replication in the action bar.",
     "screen": "Files View",
     "zone": "toolbar",
     "action": "click",
     "target": "Replication"
    },
    {
     "say": "Type {1} as the Replication factor.",
     "screen": "Set Replication Factor",
     "zone": "dialog",
     "action": "type",
     "target": "Replication factor",
     "value": "{1}"
    },
    {
     "say": "Press Save.",
     "screen": "Set Replication Factor",
     "zone": "dialog",
     "action": "click",
     "target": "Save"
    }
   ],
   "verify": "The equivalent-CLI drawer shows hdfs dfs -setrep."
  },
  {
   "id": "files-chmod",
   "title": "Change permissions",
   "match": "hdfs\\s+dfs\\s+-chmod\\s+(?:-R\\s+)?(\\d{3})\\s+((?:/[\\w.=*-]+)*)/([\\w.=*-]+)",
   "steps": [
    {
     "say": "Press the grid icon (Ambari Views) at the top right and choose Files View.",
     "screen": "Ambari",
     "zone": "top",
     "action": "click",
     "target": "Files View"
    },
    {
     "say": "Click through the path to the folder {2}.",
     "screen": "Files View",
     "zone": "main",
     "action": "click",
     "target": "{2}",
     "value": "{2}",
     "optional": true
    },
    {
     "say": "Tick the checkbox next to {3}.",
     "screen": "Files View",
     "zone": "main",
     "action": "check",
     "target": "{3}"
    },
    {
     "say": "Press Permissions in the action bar.",
     "screen": "Files View",
     "zone": "toolbar",
     "action": "click",
     "target": "Permissions"
    },
    {
     "say": "Tick the Read, Write and Execute boxes that make {1}.",
     "screen": "Edit Permission",
     "zone": "dialog",
     "action": "check",
     "target": "Read",
     "value": "{1}"
    },
    {
     "say": "Press Save.",
     "screen": "Edit Permission",
     "zone": "dialog",
     "action": "click",
     "target": "Save"
    }
   ]
  },
  {
   "id": "files-rm",
   "title": "Delete a file or folder",
   "match": "hdfs\\s+dfs\\s+-rm\\s+(?:-[rRf]+\\s+)*(?:-skipTrash\\s+)?((?:/[\\w.=*-]+)*)/([\\w.=*-]+)",
   "steps": [
    {
     "say": "Press the grid icon (Ambari Views) at the top right and choose Files View.",
     "screen": "Ambari",
     "zone": "top",
     "action": "click",
     "target": "Files View"
    },
    {
     "say": "Click through the path to the folder {1}.",
     "screen": "Files View",
     "zone": "main",
     "action": "click",
     "target": "{1}",
     "value": "{1}",
     "optional": true
    },
    {
     "say": "Tick the checkbox next to {2}.",
     "screen": "Files View",
     "zone": "main",
     "action": "check",
     "target": "{2}"
    },
    {
     "say": "Press Delete in the action bar.",
     "screen": "Files View",
     "zone": "toolbar",
     "action": "click",
     "target": "Delete"
    },
    {
     "say": "Tick Delete permanently only if you want to skip the trash.",
     "screen": "Delete",
     "zone": "dialog",
     "action": "check",
     "target": "Delete permanently"
    },
    {
     "say": "Press Delete.",
     "screen": "Delete",
     "zone": "dialog",
     "action": "click",
     "target": "Delete"
    }
   ]
  },
  {
   "id": "files-mv",
   "title": "Move a file or folder",
   "match": "hdfs\\s+dfs\\s+-mv\\s+((?:/[\\w.=*-]+)*)/([\\w.=*-]+)\\s+(/[\\w./=-]*)",
   "steps": [
    {
     "say": "Press the grid icon (Ambari Views) at the top right and choose Files View.",
     "screen": "Ambari",
     "zone": "top",
     "action": "click",

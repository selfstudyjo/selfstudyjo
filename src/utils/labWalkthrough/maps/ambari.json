    },
    {
     "say": "Click through the path to the folder {1}.",
     "screen": "Files View",
     "zone": "main",
     "action": "click",
     "target": "{1}",
     "value": "{1}",
     "optional": true
    },
    {
     "say": "Tick the checkbox next to {2}.",
     "screen": "Files View",
     "zone": "main",
     "action": "check",
     "target": "{2}"
    },
    {
     "say": "Press Move in the action bar.",
     "screen": "Files View",
     "zone": "toolbar",
     "action": "click",
     "target": "Move"
    },
    {
     "say": "Type {3} as the Destination folder.",
     "screen": "Move to",
     "zone": "dialog",
     "action": "type",
     "target": "Destination folder",
     "value": "{3}"
    },
    {
     "say": "Press Move.",
     "screen": "Move to",
     "zone": "dialog",
     "action": "click",
     "target": "Move"
    }
   ]
  },
  {
   "id": "files-cp",
   "title": "Copy a file or folder",
   "match": "hdfs\\s+dfs\\s+-cp\\s+((?:/[\\w.=*-]+)*)/([\\w.=*-]+)\\s+(/[\\w./=-]*)",
   "steps": [
    {
     "say": "Press the grid icon (Ambari Views) at the top right and choose Files View.",
     "screen": "Ambari",
     "zone": "top",
     "action": "click",
     "target": "Files View"
    },
    {
     "say": "Click through the path to the folder {1}.",
     "screen": "Files View",
     "zone": "main",
     "action": "click",
     "target": "{1}",
     "value": "{1}",
     "optional": true
    },
    {
     "say": "Tick the checkbox next to {2}.",
     "screen": "Files View",
     "zone": "main",
     "action": "check",
     "target": "{2}"
    },
    {
     "say": "Press Copy in the action bar.",
     "screen": "Files View",
     "zone": "toolbar",
     "action": "click",
     "target": "Copy"
    },
    {
     "say": "Type {3} as the Destination folder.",
     "screen": "Copy to",
     "zone": "dialog",
     "action": "type",
     "target": "Destination folder",
     "value": "{3}"
    },
    {
     "say": "Press Copy.",
     "screen": "Copy to",
     "zone": "dialog",
     "action": "click",
     "target": "Copy"
    }
   ]
  },
  {
   "id": "files-put",
   "title": "Upload a file to HDFS",
   "match": "hdfs\\s+dfs\\s+-(?:put|copyFromLocal)\\s+(?:-f\\s+)?([\\w./-]+)\\s+(/[\\w./=-]*)",
   "steps": [
    {
     "say": "Press the grid icon (Ambari Views) at the top right and choose Files View.",
     "screen": "Ambari",
     "zone": "top",
     "action": "click",
     "target": "Files View"
    },
    {
     "say": "Click through the path to the folder {2}.",
     "screen": "Files View",
     "zone": "main",
     "action": "click",
     "target": "{2}",
     "value": "{2}",

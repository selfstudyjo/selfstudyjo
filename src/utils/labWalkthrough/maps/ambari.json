    {
     "say": "Press Upload.",
     "screen": "Files View",
     "zone": "toolbar",
     "action": "click",
     "target": "Upload"
    },
    {
     "say": "Tick {1} in the list of workspace files.",
     "screen": "Upload Files",
     "zone": "dialog",
     "action": "check",
     "target": "{1}"

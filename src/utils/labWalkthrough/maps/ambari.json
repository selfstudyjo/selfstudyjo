     "say": "Press the grid icon (Ambari Views) at the top right and choose Files View.",
     "screen": "Ambari",
     "zone": "top",
     "action": "click",
     "target": "Files View"
    },
    {
     "say": "The Files View lists HDFS, starting at the root folder.",

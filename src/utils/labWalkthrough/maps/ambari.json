     "action": "click",
     "target": "{1}",
     "value": "{1}",
     "optional": true
    },
    {
     "say": "Right-click {2} and choose Info.",
     "screen": "Files View",
     "zone": "main",
     "action": "click",
     "target": "Info"
    },
    {
     "say": "Read Size, Replication and Blocks.",
     "screen": "{2}",
     "zone": "dialog",
     "action": "see",
     "target": "Blocks"
    }
   ]
  },

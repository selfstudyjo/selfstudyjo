  {
   "id": "files-cat",
   "title": "Read a file",
   "match": "hdfs\\s+dfs\\s+-(?:cat|text|tail)\\s+((?:/[\\w.=*-]+)*)/([\\w.=*-]+)",
   "steps": [
    {
     "say": "Press the grid icon (Ambari Views) at the top right and choose Files View.",
     "screen": "Ambari",
     "zone": "top",
     "action": "click",
     "target": "Files View"
    },
    {
     "say": "Click through the path to the folder {1}.",
     "screen": "Files View",
     "zone": "main",
     "action": "click",
     "target": "{1}",
     "value": "{1}",
     "optional": true
    },
    {
     "say": "Click the name {2} to open it.",
     "screen": "Files View",
     "zone": "main",
     "action": "click",
     "target": "{2}"
    },
    {
     "say": "Read the file in the preview, then press Close.",
     "screen": "{2}",
     "zone": "dialog",
     "action": "see",
     "target": "Close"
    }
   ]
  },
  {
   "id": "files-stat",
   "title": "See a file's size, replication and blocks",
   "match": "hdfs\\s+dfs\\s+-stat\\s+(?:\"[^\"]*\"\\s+)?((?:/[\\w.=*-]+)*)/([\\w.=*-]+)",
   "steps": [

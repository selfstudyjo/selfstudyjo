  {
   "id": "datanode-stop",
   "title": "Stop a DataNode",
   "match": "Stop next to DataNode|hdfs\\s+dfsadmin\\s+-shutdownDatanode\\s+([\\w.-]+)",
   "steps": [
    {
     "say": "Open Hosts in the left navigation.",
     "screen": "Hosts",
     "zone": "nav",
     "action": "click",
     "target": "Hosts"
    },
    {
     "say": "Click the host fsck named ({1}).",
     "screen": "Hosts",
     "zone": "main",
     "action": "click",
     "target": "{1}",
     "value": "{1}",
     "optional": true
    },
    {
     "say": "Click the host that holds the block.",
     "screen": "Hosts",
     "zone": "main",
     "action": "click",
     "target": "Name"
    },
    {
     "say": "Press the Started button on the DataNode row and choose Stop.",
     "screen": "Components",
     "zone": "main",
     "action": "click",
     "target": "Stop"
    },
    {
     "say": "Press Stop to confirm.",
     "screen": "Confirmation",
     "zone": "dialog",
     "action": "click",
     "target": "Stop"
    }
   ],
   "verify": "The DataNode row shows Stopped."
  },

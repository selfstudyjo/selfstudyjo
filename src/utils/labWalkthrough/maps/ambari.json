  {
   "id": "spark-config",
   "title": "Change a Spark2 configuration",
   "match": "(spark\\.sql\\.[\\w.]+),?\\s+change it to\\s+(\\w+)",
   "steps": [
    {
     "say": "Open Services in the left navigation and choose Spark2.",
     "screen": "Spark2",
     "zone": "nav",

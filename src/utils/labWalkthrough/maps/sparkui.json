{
 "skin": "sparkui",
 "product": "Apache Spark UI",
 "brand": "#e25a1c",
 "top": "Apache Spark",
 "nav": [
  "Jobs",
  "Stages",
  "Storage",
  "Environment",
  "Executors",
  "SQL / DataFrame"
 ],
 "recipes": [
  {
   "id": "cache-table",
   "title": "Cache a table from the Storage tab",
   "match": "spark-sql\\s+-e\\s+\"CACHE\\s+(LAZY\\s+)?TABLE\\s+(\\w+)\\s*\"",
   "steps": [
    {
     "say": "Click the Apache Spark logo at the top left to open the History Server list.",
     "screen": "History Server",
     "zone": "top",
     "action": "click",
     "target": "Spark"
    },
    {
     "say": "Click the App ID of the newest application.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "App ID"
    },
    {
     "say": "Open the Storage tab.",
     "screen": "Storage",
     "zone": "tab",
     "action": "click",
     "target": "Storage"
    },
    {
     "say": "Open Cache or uncache a table.",
     "screen": "Storage",
     "zone": "main",
     "action": "click",
     "target": "Cache or uncache a table"
    },
    {
     "say": "Choose {2} as the table to cache.",
     "screen": "Storage",
     "zone": "main",
     "action": "select",
     "target": "Choose a table",
     "value": "{2}"
    },
    {
     "say": "Tick LAZY.",
     "screen": "Storage",
     "zone": "main",
     "action": "check",
     "target": "LAZY",
     "value": "{1}",
     "optional": true
    },
    {
     "say": "Press Cache.",
     "screen": "Storage",
     "zone": "main",
     "action": "click",
     "target": "Cache"
    }
   ],
   "verify": "The table appears under RDDs on the Storage tab."
  },
  {
   "id": "uncache-table",
   "title": "Uncache a table",
   "match": "spark-sql\\s+-e\\s+\"UNCACHE\\s+TABLE\\s+(?:IF\\s+EXISTS\\s+)?(\\w+)\\s*\"",
   "steps": [
    {
     "say": "Click the Apache Spark logo at the top left to open the History Server list.",
     "screen": "History Server",
     "zone": "top",
     "action": "click",
     "target": "Spark"
    },
    {
     "say": "Click the App ID of the newest application.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "App ID"
    },
    {
     "say": "Open the Storage tab.",
     "screen": "Storage",
     "zone": "tab",
     "action": "click",
     "target": "Storage"
    },
    {
     "say": "Open Cache or uncache a table and pick {1}.",
     "screen": "Storage",
     "zone": "main",
     "action": "select",
     "target": "{1}",
     "value": "{1}"
    },
    {
     "say": "Press Uncache and confirm.",
     "screen": "Storage",
     "zone": "main",
     "action": "click",
     "target": "Uncache"
    }
   ]
  },
  {
   "id": "spark-sql",
   "title": "Run a Spark SQL statement",
   "match": "spark-sql\\s+-e\\s+\"([^\"]+)\"",
   "steps": [
    {
     "say": "Click the Apache Spark logo at the top left to open the History Server list.",
     "screen": "History Server",
     "zone": "top",
     "action": "click",
     "target": "Spark"
    },
    {
     "say": "Open Submit an application to the cluster under the application list.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "Submit an application"
    },
    {
     "say": "Keep Spark SQL query selected.",
     "screen": "History Server",
     "zone": "main",
     "action": "check",
     "target": "Spark SQL query"
    },
    {
     "say": "Type the statement into the query box.",
     "screen": "History Server",
     "zone": "editor",
     "action": "type",
     "target": "Spark SQL query",
     "value": "{1}"
    },
    {
     "say": "Press Run.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "Run"
    },
    {
     "say": "Click the new application and read its Jobs, Stages and SQL / DataFrame tabs.",
     "screen": "History Server",
     "zone": "main",
     "action": "see",
     "target": "App ID"
    }
   ],
   "verify": "A new application appears at the top of the list."
  },
  {
   "id": "spark-submit",
   "title": "Submit a job file",
   "match": "spark-submit\\s+(?:--[\\w-]+(?:[\\s=]+[^\\s-][^\\s]*)?\\s+)*([\\w./-]+\\.py)",
   "steps": [
    {
     "say": "Click the Apache Spark logo at the top left to open the History Server list.",
     "screen": "History Server",
     "zone": "top",
     "action": "click",
     "target": "Spark"
    },
    {
     "say": "Open Submit an application to the cluster under the application list.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "Submit an application"
    },
    {
     "say": "Choose Job file.",
     "screen": "History Server",
     "zone": "main",
     "action": "check",
     "target": "Job file"
    },
    {
     "say": "Pick {1} in the Job file list.",
     "screen": "History Server",
     "zone": "main",
     "action": "select",
     "target": "Job file",
     "value": "{1}"
    },
    {
     "say": "Press Run.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "Run"
    },
    {
     "say": "Click the new application and read its Jobs tab.",
     "screen": "History Server",
     "zone": "main",
     "action": "see",
     "target": "App ID"
    }
   ],
   "verify": "A new application appears at the top of the list."
  },
  {
   "id": "submit-sql-ui",
   "title": "Run a query from Submit an application",
   "match": "Submit an application to the cluster,? (?:keep|with) Spark SQL query",
   "steps": [
    {
     "say": "Click the Apache Spark logo at the top left to open the History Server list.",
     "screen": "History Server",
     "zone": "top",
     "action": "click",
     "target": "Spark"
    },
    {
     "say": "Open Submit an application to the cluster under the application list.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "Submit an application"
    },
    {
     "say": "Keep Spark SQL query selected.",
     "screen": "History Server",
     "zone": "main",
     "action": "check",
     "target": "Spark SQL query"
    },
    {
     "say": "Type the query into the query box.",
     "screen": "History Server",
     "zone": "editor",
     "action": "type",
     "target": "Spark SQL query"
    },
    {
     "say": "Press Run.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "Run"
    }
   ]
  },
  {
   "id": "submit-job-ui",
   "title": "Submit a job file from the History Server",
   "match": "Under Submit an application, choose Job file, pick ([\\w./-]+\\.py)",
   "steps": [
    {
     "say": "Click the Apache Spark logo at the top left to open the History Server list.",
     "screen": "History Server",
     "zone": "top",
     "action": "click",
     "target": "Spark"
    },
    {
     "say": "Open Submit an application to the cluster under the application list.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "Submit an application"
    },
    {
     "say": "Choose Job file.",
     "screen": "History Server",
     "zone": "main",
     "action": "check",
     "target": "Job file"
    },
    {
     "say": "Pick {1} in the Job file list.",
     "screen": "History Server",
     "zone": "main",
     "action": "select",
     "target": "Job file",
     "value": "{1}"
    },
    {
     "say": "Press Run.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "Run"
    }
   ]
  },
  {
   "id": "storage-see",
   "title": "See cached tables",
   "match": "Storage tab",
   "steps": [
    {
     "say": "Click the Apache Spark logo at the top left to open the History Server list.",
     "screen": "History Server",
     "zone": "top",
     "action": "click",
     "target": "Spark"
    },
    {
     "say": "Click the App ID of the application that cached the table.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "App ID"
    },
    {
     "say": "Open the Storage tab and read the RDDs list: size in memory and fraction cached.",
     "screen": "Storage",
     "zone": "tab",
     "action": "see",
     "target": "Storage"
    }
   ]
  },
  {
   "id": "summary-metrics",
   "title": "Compare a stage's task metrics",
   "match": "(?:open|compare)[^.]*(?:Summary Metrics|median and max task)|Spill \\(Memory\\)",
   "steps": [
    {
     "say": "Click the Apache Spark logo at the top left to open the History Server list.",
     "screen": "History Server",
     "zone": "top",
     "action": "click",
     "target": "Spark"
    },
    {
     "say": "Click the App ID of the application.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "App ID"
    },
    {
     "say": "Open the Stages tab.",
     "screen": "Stages for All Jobs",
     "zone": "tab",
     "action": "click",
     "target": "Stages"
    },
    {
     "say": "Click the Duration header to sort, then click the slowest stage.",
     "screen": "Stages for All Jobs",
     "zone": "main",
     "action": "click",
     "target": "Duration"
    },
    {
     "say": "Read Summary Metrics: compare Median with Max, and the Spill rows.",
     "screen": "Details for Stage",
     "zone": "main",
     "action": "see",
     "target": "Summary Metrics"
    }
   ]
  },
  {
   "id": "stages-see",
   "title": "Read an application's stages",
   "match": "open Stages|Click into a job and read its stages",
   "steps": [
    {
     "say": "Click the Apache Spark logo at the top left to open the History Server list.",
     "screen": "History Server",
     "zone": "top",
     "action": "click",
     "target": "Spark"
    },
    {
     "say": "Click the App ID of the application.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "App ID"
    },
    {
     "say": "Open the Stages tab.",
     "screen": "Stages for All Jobs",
     "zone": "tab",
     "action": "click",
     "target": "Stages"
    },
    {
     "say": "Read Tasks: Succeeded/Total and Shuffle Read / Shuffle Write per stage.",
     "screen": "Stages for All Jobs",
     "zone": "main",
     "action": "see",
     "target": "Tasks: Succeeded/Total"
    }
   ]
  },
  {
   "id": "jobs-see",
   "title": "Read an application's jobs",
   "match": "Jobs page|look at its Jobs",
   "steps": [
    {
     "say": "Click the Apache Spark logo at the top left to open the History Server list.",
     "screen": "History Server",
     "zone": "top",
     "action": "click",
     "target": "Spark"
    },
    {
     "say": "Click the App ID of the application.",
     "screen": "History Server",
     "zone": "main",
     "action": "click",
     "target": "App ID"
    },
    {
     "say": "Read the Jobs tab: one row per job, with its stages.",
     "screen": "Spark Jobs",
     "zone": "tab",
     "action": "see",
     "target": "Jobs"
    }
   ]
  },
  {
   "id": "history-see",
   "title": "Find an application",
   "match": "Compare the new application with the old one|History Server (?:tab|page)",
   "steps": [
    {
     "say": "Click the Apache Spark logo at the top left to open the History Server list.",
     "screen": "History Server",
     "zone": "top",
     "action": "click",
     "target": "Spark"
    },
    {
     "say": "Read the App Name, Started and Duration columns.",
     "screen": "History Server",
     "zone": "main",
     "action": "see",
     "target": "Duration"
    }
   ]
  }
 ]
}
